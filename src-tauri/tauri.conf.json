{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fighters Guild Launcher",
  "version": "1.0.2",
  "identifier": "app.fightersguild.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "beforeBuildCommand": "node node_modules/vite/bin/vite.js build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fighters Guild Launcher",
        "width": 520,
        "height": 720,
        "minWidth": 460,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/RadSoloCup/fightersguild-launcher/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2QUVCNEY2NDMwMjlEMzgKUldRNG5RSkQ5clN1NWxUNjFvaU84MjNzZEpYamgyYUtLV1BMNEhuQ0NBdVRYbjFEUDlBOG9IV3cK"
    }
  }
}
